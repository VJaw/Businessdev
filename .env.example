# --- Required ---
# Paste your real keys here. This file is gitignored.
OPENAI_API_KEY=
SERPER_API_KEY=

# --- Models ---
# Cheaper model for the two research agents.
RESEARCH_MODEL=gpt-4o-mini
# Stronger model for the business development agent.
WRITER_MODEL=gpt-4o

# --- Search budget ---
# Serper free tier is a one-time allowance, not monthly. Keep these low.
SERPER_MAX_RESULTS=8
MAX_SEARCHES_PER_AGENT=4

# --- Crew ---
MAX_RPM=20
